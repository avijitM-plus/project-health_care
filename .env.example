# IASIS AI — Environment Variables
# Copy this file to .env and update the values.

# Groq API Configuration
GROQ_API_KEY=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
GROQ_PRIMARY_MODEL=qwen/qwen3-32b
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Upload Limits (bytes)
MAX_UPLOAD_SIZE=20971520

# Rate Limiting
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS Origins (comma-separated)
CORS_ORIGINS=*

# Tesseract OCR path (Windows only, uncomment if needed)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# MedGemma 4B — Chest X-ray Analysis
# Requires a HuggingFace dedicated inference endpoint for google/medgemma-4b-it
# Leave blank to disable imaging analysis (service will return unavailable responses)
MEDGEMMA_ENDPOINT=https://your-endpoint.us-east-1.aws.endpoints.huggingface.cloud
HF_TOKEN=hf_your_token_here
MEDGEMMA_TIMEOUT=60

# Gemini API — natural Bangla response generation layer
# Get key from: https://aistudio.google.com/app/apikey
# Leave empty to disable (Qwen Bangla response used as fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=15
